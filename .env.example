# ─────────────────────────────────────────────────────────────────────────────
# TalbotIQ PMS · environment template (PRODUCTION-oriented)
# Copy to `.env` and fill in. Placeholders only — NEVER commit real secrets.
# Every variable THIS app reads is documented here (verified against
# config/settings/base.py + prod.py). Values marked [PROD] are what a real
# deployment must set; values marked [dev only] are for local docker-compose.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Django core ─────────────────────────────────────────────────────────────
# [PROD] MUST be config.settings.prod (fail-closed: refuses to boot without a
# real SECRET_KEY + ALLOWED_HOSTS; DEBUG is hard-coded False there).
# [dev only] config.settings.dev for local compose.
DJANGO_SETTINGS_MODULE=config.settings.prod
# [PROD] REQUIRED — no fallback in prod. Generate:
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE-ME-generate-a-long-random-value
# [PROD] must be false (prod settings force DEBUG=False regardless; never rely
# on this alone). [dev only] true.
DJANGO_DEBUG=false
# [PROD] REQUIRED — the real domain(s), comma-separated. NEVER "*" in production.
DJANGO_ALLOWED_HOSTS=pms.your-company.com
# [PROD] the SPA origin(s) for CSRF on the session (SSO) flows, comma-separated.
DJANGO_CSRF_TRUSTED_ORIGINS=https://pms.your-company.com
# TLS is usually terminated at the load balancer; the app redirects HTTP→HTTPS.
DJANGO_SECURE_SSL_REDIRECT=true
# HSTS max-age seconds (default 1 year).
DJANGO_HSTS_SECONDS=31536000
# Root log level for the app loggers (INFO in prod; DEBUG only when diagnosing).
LOG_LEVEL=INFO

# ─── Database (MySQL 8 — the stack is MySQL-locked, not Postgres) ────────────
DB_NAME=pms
DB_USER=pms
# [PROD] from your secrets manager.
DB_PASSWORD=CHANGE-ME
DB_HOST=your-mysql-host
DB_PORT=3306
# Persistent-connection lifetime seconds (60 is a good default; see the
# max_connections sizing note in config/settings/base.py).
DB_CONN_MAX_AGE=60
# [PROD] TLS to a managed MySQL: path to the provider's CA bundle inside the
# container. Unset → plain connection (dev only).
DB_SSL_CA=
# Optional READ REPLICA — reads route to it automatically (apps/core/dbrouter);
# unset → the primary serves reads too (safe default, config-only to add later).
DB_REPLICA_HOST=
DB_REPLICA_PORT=3306
DB_REPLICA_USER=
DB_REPLICA_PASSWORD=
# [dev only] used by docker-compose to initialise the local MySQL container.
DB_ROOT_PASSWORD=CHANGE-ME-dev-only

# ─── Redis 7 + Celery (background AI jobs, cache, sessions) ──────────────────
# PRODUCTION: TWO managed Redis instances — the BROKER must run maxmemory-policy
# noeviction (never drop a queued job); the CACHE/SESSIONS instance runs
# allkeys-lru. One instance cannot satisfy both (see DEPLOYMENT_HANDOVER.md).
CELERY_BROKER_URL=redis://your-redis-broker:6379/0
CELERY_RESULT_BACKEND=redis://your-redis-broker:6379/0
REDIS_CACHE_URL=redis://your-redis-cache:6379/1
REDIS_SESSION_URL=redis://your-redis-cache:6379/2
# [PROD] must be false — run real celery worker + beat processes. true is the
# free-demo shim that executes jobs inline in the web request.
CELERY_TASK_ALWAYS_EAGER=false
# Approval-escalation sweep interval (celery beat), seconds.
APPROVALS_ESCALATION_INTERVAL_SECONDS=300

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
# Access/refresh lifetimes. Refresh tokens rotate + blacklist on use and are
# revoked on logout, on password reset/change, and per device session.
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Account lockout (PHASE2): login attempts per (tenant,email) window before 429;
# resets on success; 0 disables. The per-IP throttle still applies.
LOGIN_LOCKOUT_ATTEMPTS=8
LOGIN_LOCKOUT_WINDOW_SECONDS=900

# ─── Media (avatar/logo uploads — PHASE2) ─────────────────────────────────────
# A mounted volume path in production (object storage is the documented upgrade
# path). Files are served ONLY through authenticated, scope-checked endpoints.
MEDIA_ROOT=/app/media

# ─── Email / SMTP (password reset + notifications) — REQUIRED for real users ──
# [PROD] the smtp backend + a real provider (SES/SendGrid/Mailgun/...).
# [dev only] the console backend prints mail to the web container log.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE-ME
EMAIL_HOST_PASSWORD=CHANGE-ME
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=TalbotIQ PMS <no-reply@your-company.com>
# [PROD] the public SPA base URL — password-reset links in email point here.
PUBLIC_APP_URL=https://pms.your-company.com

# ─── AI provider: Gemini (enterprise key) — the configured provider ──────────
LLM_PROVIDER=apps.ai.gemini_provider.GeminiProvider
# [PROD] from your secrets manager. Unset → AI features return a clean 503
# (nothing fabricated); the rest of the app works normally.
GEMINI_API_KEY=your-gemini-key-here
# Model split (optional — sensible defaults ship in settings): a strong model
# for the human-read agents (review/feedback/succession/JD/career) + a fast one
# for chat. Defaults: best=gemini-pro-latest, fast=gemini-2.5-flash.
# (gemini-2.5-pro is blocked for new API projects; pro models "think", so
# LLM_MAX_TOKENS defaults to 4096.)
# GEMINI_MODEL_BEST=gemini-pro-latest
# GEMINI_MODEL_FAST=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Force ONE model for every agent (rate-limited tiers): GEMINI_MODEL=gemini-2.5-flash
# Per-agent overrides (must be Gemini ids for the Gemini provider):
# LLM_MODEL_REVIEW= / LLM_MODEL_FEEDBACK= / LLM_MODEL_SUCCESSION= /
# LLM_MODEL_JD= / LLM_MODEL_CAREER= / LLM_MODEL_CHAT= / LLM_MODEL_DEFAULT=

# Alternative providers (switchable by config; keys only used when selected):
# LLM_PROVIDER=apps.ai.openai_provider.OpenAIProvider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_PROVIDER=apps.ai.groq.GroqProvider (+ Groq model names in LLM_MODEL_*)
GROQ_API_KEY=
# Generic fallback key/base some providers read when their specific one is unset.
# LLM_API_KEY= / LLM_BASE_URL=
# Optional LangSmith tracing key (leave blank to disable).
LANGSMITH_API_KEY=

# ─── AI cost controls ─────────────────────────────────────────────────────────
# Deployment-wide 24h LLM call ceiling — a runaway-loop backstop, NOT the cost
# control (that's the per-tenant AgentBudget). [PROD] size to tenant count
# (≈ tenants × per-tenant daily cap × headroom), or 0 to disable and rely on
# per-tenant budgets + a provider-side dollar cap. 60 is the [dev only] value.
LLM_MAX_CALLS=2000
# Max output tokens per call (Gemini pro models "think" — keep ≥4096).
LLM_MAX_TOKENS=4096
# Per-call provider timeout, seconds.
LLM_TIMEOUT_SECONDS=30

# ─── OAuth / OIDC SSO (optional; per-tenant IdP) ─────────────────────────────
OIDC_PROVIDER_ID=oidc-demo
OIDC_PROVIDER_NAME=Demo OIDC
OIDC_CLIENT_ID=demo-client-id
OIDC_CLIENT_SECRET=CHANGE-ME-if-using-oidc
OIDC_SERVER_URL=https://oidc.example.com
# Fallback tenant slug for an OIDC identity with no tenant hint.
OIDC_DEFAULT_TENANT_SLUG=

# ─── Throttling ───────────────────────────────────────────────────────────────
# Anonymous (login/reset, per-IP) rate. Authenticated/tenant/AI rates come from
# the tenant's entitlement (apps/billing), not env.
THROTTLE_ANON=100/min

# ─── Observability ────────────────────────────────────────────────────────────
# [PROD] REQUIRED for the token-gated Prometheus /metrics endpoint — the scraper
# sends `Authorization: Bearer <METRICS_TOKEN>`. Unset → /metrics is disabled.
METRICS_TOKEN=CHANGE-ME-long-random
# Sentry: blank disables cleanly. [PROD] set the DSN + environment name.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
# Flower (Celery dashboard) basic-auth "user:password". [PROD] a REAL credential
# from the secrets manager — never the placeholder, never unauthenticated.
FLOWER_BASIC_AUTH=CHANGE-ME-user:CHANGE-ME-strong-password

# ─── Gunicorn (web process) ──────────────────────────────────────────────────
# GUNICORN_BIND=0.0.0.0:8000
# GUNICORN_LOGLEVEL=info

# ─── Product scope (v1) ──────────────────────────────────────────────────────
# Hide the cohort-relative T-score number in agent text (matches the UI). Set
# false to restore it in v2.
V1_HIDE_TSCORE=true
