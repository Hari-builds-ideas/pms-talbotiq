# ─────────────────────────────────────────────────────────────────────────
# PMS — Talbotiq · environment template
# Copy to `.env` and adjust. docker-compose reads this file for variable
# substitution; the `web`/`celery-*` services receive the values below.
# Every variable the app reads is documented here.
# ─────────────────────────────────────────────────────────────────────────

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.dev
# REQUIRED in production: config.settings.prod has NO fallback and will refuse to
# start if this is unset (so it can never sign JWTs with the public dev default).
# Generate a real one: `python -c "import secrets;print(secrets.token_urlsafe(64))"`
DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_DEBUG=true
# Comma-separated. Used by dev/prod settings.
DJANGO_ALLOWED_HOSTS=*

# --- Database (MySQL 8) ---
DB_NAME=pms
DB_USER=pms
DB_PASSWORD=pmspw
DB_HOST=mysql
DB_PORT=3306
# Only used by docker-compose to initialise the MySQL container.
DB_ROOT_PASSWORD=rootpw

# --- Redis 7 (split by logical DB) ---
# /0 = Celery broker + results (MUST be noeviction — see docker-compose redis)
# /1 = application cache (TTL'd)        /2 = sessions
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
REDIS_SESSION_URL=redis://redis:6379/2

# --- OAuth / OIDC (generic provider; demoable with placeholder values) ---
# A real deployment points these at the tenant's IdP. Defaults below let the
# provider be configured without any real secret — see apps/identity/adapters.py.
OIDC_PROVIDER_ID=oidc-demo
OIDC_PROVIDER_NAME=Demo OIDC
OIDC_CLIENT_ID=demo-client-id
OIDC_CLIENT_SECRET=demo-secret
OIDC_SERVER_URL=https://oidc.example.com
# Fallback tenant slug an OIDC identity maps into when the login carries no
# explicit tenant hint (demo convenience; real multi-tenant OIDC keys per issuer).
OIDC_DEFAULT_TENANT_SLUG=

# --- AI provider: Gemini (enterprise) — the configured provider for the demo ---
# Hari's one action: paste the enterprise Gemini key next to GEMINI_API_KEY below in the
# gitignored .env (NEVER commit it), then restart web + worker. Unset → the provider is
# unconfigured and the agents return a clean 503 (nothing fabricated).
LLM_PROVIDER=apps.ai.gemini_provider.GeminiProvider
GEMINI_API_KEY=your-gemini-key-here
# Model split (both optional — sensible defaults ship in settings): a strong model for
# the human-read agents (review/feedback/succession/JD/career) + a fast model for
# chat/default. Defaults: best=gemini-pro-latest, fast=gemini-2.5-flash. (gemini-2.5-pro
# is blocked for new API projects; the pro "-latest"/3.x models are "thinking" models,
# so LLM_MAX_TOKENS defaults to 4096.) Override the ids if your project exposes others:
# GEMINI_MODEL_BEST=gemini-3.1-pro-preview
# GEMINI_MODEL_FAST=gemini-2.5-flash
# Optional per-agent overrides (must be Gemini model ids for the Gemini provider):
# LLM_MODEL_REVIEW=gemini-pro-latest
# LLM_MODEL_CHAT=gemini-2.5-flash

# --- Other providers (switchable by config — OpenAI/Groq kept intact) ---
# To use OpenAI instead: set LLM_PROVIDER=apps.ai.openai_provider.OpenAIProvider + a key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# To use Groq: set LLM_PROVIDER=apps.ai.groq.GroqProvider + GROQ_API_KEY + Groq model
# names in LLM_MODEL_* (llama-3.3-70b-versatile / llama-3.1-8b-instant).
GROQ_API_KEY=
# Run-wide global call ceiling (cache-counted across web+celery) — a hard backstop
# against a runaway loop. Raise as needed for the demo.
LLM_MAX_CALLS=60
LLM_MAX_TOKENS=900

# --- Throttling (DRF, Redis-backed) ---
# Anonymous (login/IP) rate. The tenant/user/ai rates are NOT set here — they
# come from the tenant's entitlement (apps/billing/services.rate_limits_for).
THROTTLE_ANON=100/min

# --- Observability ---
# Sentry: leave SENTRY_DSN blank to disable (app boots normally). PII is scrubbed.
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
# 0.0 = performance tracing off unless explicitly configured.
SENTRY_TRACES_SAMPLE_RATE=0.0
# Flower (Celery dashboard) basic-auth, "user:password". NEVER run it unauthenticated.
FLOWER_BASIC_AUTH=admin:flowerpass
