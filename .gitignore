# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
# `build/` above is a Python artifact rule, but macOS matches ignore patterns
# case-insensitively, so it also swallows docs/BUILD/ — which is documentation,
# not an artifact. Re-include it explicitly.
!docs/BUILD/

# Virtualenvs
.venv/
venv/
env/

# Environment / secrets
.env
*.env
!.env.example

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Local DB artifacts
*.sqlite3

# Celery beat scheduler state (runtime artifact)
celerybeat-schedule*
celerybeat.pid

# OS / editor
.DS_Store
docs/.DS_Store
.idea/
.vscode/

# Figma Make design export — reference only, not part of the app
Enterprise AI Performance Management/

# Scratch: overnight run prompts/logs (not part of the codebase)
overnight/

# collectstatic output — a build artifact, produced in the image (see Dockerfile).
# The directory itself stays (STATIC_ROOT), so .gitkeep is kept explicitly.
staticfiles/*
!staticfiles/.gitkeep

# Local env files that are not the committed placeholder template.
env-for-testing.txt
.gstack/
backups/
*.sql.gz
*.sql
