[Unit]
# Weekly restore drill (C5). A backup nobody has restored is a hypothesis.
#
# This deliberately pulls the OFFSITE copy (--from-bucket) rather than the local
# one. Restoring the local file proves the local file is good and tells you
# nothing about the copy you will actually reach for when the host is gone.
Description=Axiom PMS — weekly restore drill (proves the backup is recoverable)
Documentation=file:///srv/pms/docs/BUILD/BACKUP_RESTORE.md
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/pms
EnvironmentFile=/srv/pms/.env.backup
Environment=GCS_BUCKET=gs://axiom-backups
Environment=BACKUP_DIR=/var/backups/pms

# Restores into test_restore_drill and drops it again; never writes to the live
# database. See the header of restore_drill.sh.
ExecStart=/srv/pms/scripts/restore_drill.sh --from-bucket

Nice=10
IOSchedulingClass=idle
Restart=no
TimeoutStartSec=3600

User=root
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
ReadWritePaths=/var/backups/pms /srv/pms/backups

[Install]
WantedBy=multi-user.target
