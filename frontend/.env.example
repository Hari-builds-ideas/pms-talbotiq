# Copy to .env. Default FALSE = live API with REAL auth (the safe default — no
# passwordless path). Set true ONLY for standalone UI work against the MSW mock
# layer (where "any password works"); point VITE_API_BASE_URL at the Django backend.
VITE_USE_MOCKS=false
VITE_API_BASE_URL=/api

# Shows the Login-page "Sign in with Google" button. Keep false until the backend
# has GOOGLE_OAUTH_CLIENT_ID/SECRET configured for this deployment.
VITE_GOOGLE_SSO_ENABLED=false
